+def _prospace_mm_types(model, input_ids, pixel_values, pixel_values_videos, kwargs):
+    """ProSpace (2026-09-25): transformers 5.x needs mm_token_type_ids for M-RoPE; the pinned transformers did not.
+    0 = text, 1 = image token, 2 = video token (same convention as the processor)."""
+    if kwargs.get("mm_token_type_ids") is None and input_ids is not None and (pixel_values is not None or pixel_values_videos is not None):
+        import torch as _t
+        t = _t.zeros_like(input_ids, dtype=_t.int32)
+        t[input_ids == model.config.image_token_id] = 1
+        t[input_ids == model.config.video_token_id] = 2
+        kwargs["mm_token_type_ids"] = t
+    return kwargs
+
